# Model provider: "anthropic" or "bedrock"
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-5
# Bedrock only
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Cognee Cloud
COGNEE_SERVICE_URL=
COGNEE_API_KEY=

# Bright Data
BRIGHTDATA_API_TOKEN=

# Oura ring: OAuth app at https://cloud.ouraring.com/oauth/applications
# Redirect URI (HTTPS required): $OAUTH_BASE_URL/oauth/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_USE_SANDBOX=            # 1 -> Oura's sandbox (fake data, no ring or token needed)
# Google Calendar: OAuth web client, redirect URI $OAUTH_BASE_URL/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public HTTPS origin of this server: the cloudflared tunnel on the laptop, the Lightsail URL on AWS.
# Must byte-match the redirect URIs registered with Oura and Google. Connect buttons render only at this origin.
OAUTH_BASE_URL=https://example.trycloudflare.com
# Container deploys only: tokens/ is empty in the image, so paste each laptop token file as one line of JSON
# (python -c 'import json;print(json.dumps(json.load(open("tokens/oura.json"))))'). Written to tokens/ on first use.
OURA_TOKEN_JSON=
GOOGLE_TOKEN_JSON=
LOCAL_TZ=America/Los_Angeles
